-- FIXED: ExecuteFastAttack - Now properly handles all weapon types without causing invisible attacks
local function ExecuteFastAttack(targetPlr)
    if not IsPlayerAlive(LocalPlayer) or not IsPlayerAlive(targetPlr) then return end
    
    local myChar = GetCharacter(LocalPlayer)
    local tChar = GetCharacter(targetPlr)
    local tHead = tChar and tChar:FindFirstChild("Head")
    local tHrp = GetRootPart(targetPlr)
    local myHrp = GetRootPart(LocalPlayer)
    
    if not myChar or not tHead or not tHrp or not myHrp then return end
    if (myHrp.Position - tHrp.Position).Magnitude > 68 then return end
    
    local equippedTool = myChar:FindFirstChildOfClass("Tool")
    if not equippedTool then return end
    
    -- Blox Fruit M1 Attack
    if equippedTool.ToolTip == "Blox Fruit" then
        local leftClickRemote = equippedTool:FindFirstChild("LeftClickRemote")
        if leftClickRemote then
            local dir = (tHrp.Position - myHrp.Position).Unit
            State.ComboCounter = (State.ComboCounter % 4) + 1
            pcall(function()
                leftClickRemote:FireServer(dir, State.ComboCounter, true)
            end)
            return
        end
    end
    
    -- Melee/Sword/Gun using CombatNet
    if not RegisterAttack or not RegisterHit then
        ResolveCombatNet()
    end
    
    if RegisterAttack and RegisterHit then
        pcall(function()
            local otherBladeHits = {}
            for _, otherPlr in ipairs(Players:GetPlayers()) do
                if otherPlr ~= LocalPlayer and IsPlayerAlive(otherPlr) then
                    local oChar = GetCharacter(otherPlr)
                    local oHead = oChar and oChar:FindFirstChild("Head")
                    local oHrp = GetRootPart(otherPlr)
                    if oChar and oHead and oHrp and (myHrp.Position - oHrp.Position).Magnitude <= 65 then
                        table.insert(otherBladeHits, {oChar, oHead})
                    end
                end
            end
            if #otherBladeHits == 0 then
                table.insert(otherBladeHits, {tChar, tHead})
            end
            
            -- FIXED: Properly fire attack remotes
            RegisterAttack:FireServer(0)
            task.wait(0.01)
            RegisterHit:FireServer(tHead, otherBladeHits)
        end)
    elseif VirtualUser then
        -- Fallback to VirtualUser click
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(0, 0))
        end)
    end
end

-- Skill Combo System
local function EquipWeaponByType(toolTipType)
    local char = GetCharacter(LocalPlayer)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local hum = GetHumanoid(LocalPlayer)
    if not char or not backpack or not hum then return nil end
    
    local current = char:FindFirstChildOfClass("Tool")
    if current and current.ToolTip == toolTipType then
        return current
    end
    
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and item.ToolTip == toolTipType then
            hum:EquipTool(item)
            task.wait(0.2)
            return item
        end
    end
    return nil
end

local function ExecuteSkillComboStep()
    local rotationOrder = {}
    if Config.UseMelee then table.insert(rotationOrder, "Melee") end
    if Config.UseSword then table.insert(rotationOrder, "Sword") end
    if Config.UseFruit then table.insert(rotationOrder, "Blox Fruit") end
    if Config.UseGun then table.insert(rotationOrder, "Gun") end
    if #rotationOrder == 0 then return end
    
    State.WeaponCycleIndex = (State.WeaponCycleIndex % #rotationOrder) + 1
    local chosenType = rotationOrder[State.WeaponCycleIndex]
    
    EquipWeaponByType(chosenType)
    task.wait(0.1)
    
    if chosenType == "Melee" then
        if Config.Melee_Z then SendKeyPress(Enum.KeyCode.Z, Config.MeleeHoldZ) end
        if Config.Melee_X then SendKeyPress(Enum.KeyCode.X, Config.MeleeHoldX) end
        if Config.Melee_C then SendKeyPress(Enum.KeyCode.C, Config.MeleeHoldC) end
    elseif chosenType == "Sword" then
        if Config.Sword_Z then SendKeyPress(Enum.KeyCode.Z, Config.SwordHoldZ) end
        if Config.Sword_X then SendKeyPress(Enum.KeyCode.X, Config.SwordHoldX) end
    elseif chosenType == "Blox Fruit" then
        if Config.Fruit_Z then SendKeyPress(Enum.KeyCode.Z, Config.FruitHoldZ) end
        if Config.Fruit_X then SendKeyPress(Enum.KeyCode.X, Config.FruitHoldX) end
        if Config.Fruit_C then SendKeyPress(Enum.KeyCode.C, Config.FruitHoldC) end
        if Config.Fruit_V then SendKeyPress(Enum.KeyCode.V, Config.FruitHoldV) end
    elseif chosenType == "Gun" then
        if Config.Gun_Z then SendKeyPress(Enum.KeyCode.Z, Config.GunHoldZ) end
        if Config.Gun_X then SendKeyPress(Enum.KeyCode.X, Config.GunHoldX) end
    end
end

-- Soru/Geppo GC Patch
local function PatchSoruAndGeppoGC()
    local char = GetCharacter(LocalPlayer)
    if not char then return end
    local soruScript = char:FindFirstChild("Soru")
    local geppoScript = char:FindFirstChild("Geppo")
    
    pcall(function()
        for _, fn in pairs(getgc()) do
            if type(fn) == "function" then
                local envOk, env = pcall(getfenv, fn)
                if envOk and env and (env.script == soruScript or env.script == geppoScript) then
                    local upOk, ups = pcall(debug.getupvalues, fn)
                    if upOk and ups then
                        for _, upVal in pairs(ups) do
                            if type(upVal) == "table" then
                                if upVal.LastUse then upVal.LastUse = 0 end
                                if upVal.Cooldown then upVal.Cooldown = 0 end
                                if upVal.SkyJump then upVal.SkyJump = 0 end
                            end
                        end
                    end
                end
            end
        end
    end)
end

--========================================================================================
-- FIXED: SILENT AIM HOOK - Prevents attacks from disappearing
--========================================================================================

if hookmetamethod and not State.SilentAimHooked then
    pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            -- Only intercept if Silent Aim is enabled and not from our own code
            if not checkcaller() and Config.SilentAim and (method == "FireServer" or method == "InvokeServer") then
                local target = State.LockedTarget or State.CurrentTarget
                if target and IsPlayerAlive(target) then
                    local tChar = GetCharacter(target)
                    local aimPart = (tChar and tChar:FindFirstChild(Config.AimPart)) or GetRootPart(target)
                    
                    if aimPart and aimPart:IsA("BasePart") then
                        -- Calculate predicted position
                        local velocity = aimPart.AssemblyLinearVelocity or Vector3.zero
                        local predictedPos = aimPart.Position + (velocity * Config.PredictionFactor)
                        
                        local remoteName = tostring(self.Name)
                        
                        -- FIXED: Handle various remote argument patterns without breaking attacks
                        if remoteName == "RemoteEvent" or remoteName == "CommE" or remoteName:find("Event") then
                            -- MousePos as first argument (vector)
                            if typeof(args[1]) == "Vector3" then
                                args[1] = predictedPos
                                return oldNamecall(self, unpack(args))
                            -- MousePos as second argument after string
                            elseif typeof(args[1]) == "string" and typeof(args[2]) == "Vector3" then
                                args[2] = predictedPos
                                return oldNamecall(self, unpack(args))
                            -- CFrame argument
                            elseif typeof(args[1]) == "CFrame" then
                                args[1] = CFrame.new(predictedPos)
                                return oldNamecall(self, unpack(args))
                            end
                        end
                        
                        -- Handle ModuleScript remotes (RegisterAttack/RegisterHit)
                        if remoteName:find("Register") and typeof(args[1]) == "Vector3" then
                            args[1] = predictedPos
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
            end
            
            -- Pass through all other calls unchanged
            return oldNamecall(self, ...)
        end))
        
        State.SilentAimHooked = true
    end)
end

