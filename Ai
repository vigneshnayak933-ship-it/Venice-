-- Configuration Persistence
local ConfigFolderName = "HermanosDev_Config_v2"
local ConfigFileName = ConfigFolderName .. "/BloxFruits_PVP_v20.json"

local function SaveConfiguration()
    if not writefile then return false end
    pcall(function()
        if makefolder and isfolder and not isfolder(ConfigFolderName) then
            makefolder(ConfigFolderName)
        end
        local serializable = {}
        for k, v in pairs(Config) do
            if typeof(v) == "EnumItem" then
                serializable[k] = v.Name
            else
                serializable[k] = v
            end
        end
        writefile(ConfigFileName, HttpService:JSONEncode(serializable))
    end)
    return true
end

local function LoadConfiguration()
    if not readfile or not isfile or not isfile(ConfigFileName) then return false end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(ConfigFileName))
    end)
    if ok and type(decoded) == "table" then
        for k, v in pairs(decoded) do
            if Config[k] ~= nil then
                if typeof(Config[k]) == "EnumItem" and type(v) == "string" and Enum.KeyCode[v] then
                    Config[k] = Enum.KeyCode[v]
                else
                    Config[k] = v
                end
            end
        end
        return true
    end
    return false
end

